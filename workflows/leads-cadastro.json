        "jsonOutput": "={\n  ...$json,\n  \"status_cadastro\": \"invalido\",\n  \"status_notificacao\": \"nao_aplicavel\",\n  \"observacoes\": $json.nome !== \"\" ? \"E-mail invalido ou ausente\" : \"Nome ausente\"\n}",
        "options": {}
